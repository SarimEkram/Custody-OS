# ---------------------------------------------------------------
# CustodyOS environment. NEVER commit this file (.gitignore covers it).
# Fill in the blanks; leave the defaults unless you know why.
# ---------------------------------------------------------------

# --- MongoDB Atlas (M10 cluster; one user per service, see DATA_MODEL.md "Database users and roles")
# Format: mongodb+srv://<user>:<password>@<cluster-host>/custody?retryWrites=true&w=majority
MONGODB_URI_AGENT=        # agent_svc   -> ledgerAppender + custodyEventsReader + agentState
MONGODB_URI_SCANNER=      # scanner_svc -> custodyEventsWriter + read samples/locations/identities
MONGODB_URI_ADMIN=        # admin_svc   -> readWrite@custody + dbAdmin@custody (seed, indexes, revoke)
MONGODB_DB=custody

# --- LLM (agent loop + auditor query parsing). Groq free API, OpenAI-compatible.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Embeddings (Vector Search; owned by Person A). Embedding model only, not the LLM.
# atlas_auto: Atlas Automated Embedding, leave VOYAGE_API_KEY empty.
# voyage: key from Atlas > AI Model APIs > Model API Keys.
EMBEDDINGS_PROVIDER=atlas_auto   # atlas_auto (verified) | voyage
AUTO_EMBED_MODEL=voyage-4        # Automated Embedding supports voyage-4, -4-large, -4-lite, -code-4, -code-3
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1   # MongoDB-hosted Voyage endpoint
VOYAGE_MODEL=voyage-3.5
EMBED_DIM=1024

# --- ElevenLabs (voice intake, server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3
# Optional spoken read-backs (stretch only; leave commented out otherwise)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_TTS_VOICE_ID=

# --- Scanner signing (HMAC on custody_events). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SCANNER_HMAC_SECRET=

# --- Service ports
AGENT_PORT=8000
FREEZER_PORT=8101
SCHEDULER_PORT=8102
COURIER_PORT=8103
STATION_PORT=8104
SCANNER_PORT=8105

# --- Service URLs (agent -> lab services, lab services -> scanner)
FREEZER_URL=http://localhost:8101
SCHEDULER_URL=http://localhost:8102
COURIER_URL=http://localhost:8103
STATION_URL=http://localhost:8104
SCANNER_URL=http://localhost:8105

# --- Demo tuning
DEMO_SPEED=60                 # 1 real second = 1 simulated minute
DEMO_SCRIPTED=0               # 1 = replay recorded tool calls, no model call
VERIFIER_TIMEOUT_SECONDS=10
STT_TIMEOUT_SECONDS=5
MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=1048576
LOW_CONFIDENCE_LOGPROB=-1.0   # words below this trigger "did you mean"
