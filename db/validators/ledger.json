{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["timestamp", "entry_type", "actor", "on_behalf_of", "grant_id", "policy_id", "policy_version",
                 "decision", "transfer_id", "correlation_id", "request_id"],
    "properties": {
      "timestamp":      { "bsonType": "date" },
      "entry_type":     { "enum": ["intake", "confirmation", "decision", "outcome", "verification", "compensation",
                                   "recovery", "exposure", "violation", "correction"] },
      "actor":          { "bsonType": "string", "pattern": "^(agent|user|system):" },
      "on_behalf_of":   { "bsonType": "string", "pattern": "^user:" },
      "grant_id":       { "bsonType": ["string", "null"] },
      "policy_id":      { "bsonType": "string", "minLength": 1 },
      "policy_version": { "bsonType": ["int", "long"] },
      "decision":       { "enum": ["allow", "deny", "pending_approval", "pending_confirmation", "halt"] },
      "request_id":     { "bsonType": ["string", "null"] },
      "status":         { "enum": ["sent", "confirmed", "mismatch", "unconfirmed", null] },
      "reversible":     { "bsonType": ["bool", "null"] },
      "transfer_id":    { "bsonType": "string", "minLength": 1 },
      "correlation_id": { "bsonType": "string", "minLength": 1 },
      "reason":         { "bsonType": ["string", "null"] },
      "summary":        { "bsonType": ["string", "null"] },
      "refs":           { "bsonType": "array", "items": { "bsonType": "objectId" } },
      "embedding":      { "bsonType": "array" }
    }
  }
}
