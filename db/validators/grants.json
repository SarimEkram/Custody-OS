{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["grantor", "grantee", "status", "scope", "expires_at"],
    "properties": {
      "grantor":    { "bsonType": "string", "pattern": "^user:" },
      "grantee":    { "bsonType": "string", "pattern": "^agent:" },
      "status":     { "enum": ["active", "revoked"] },
      "scope":      { "bsonType": "object", "required": ["actions"] },
      "expires_at": { "bsonType": "date" }
    }
  }
}
